+});
+test('source transition reasons must match exact ledger entries',t=>{
+ const f=fixture(t);f.ledger.changes[MERGED_SOURCE_PATHS[0]].reason='Different reason';f.save();assert.throws(f.check,/beyond the two source transitions/);
+});
+test('additional final-source exceptions cannot be introduced',t=>{
+ const f=fixture(t);f.record.source_transitions.push({...f.record.source_transitions[0],path:'code/evaluation/nyt/scoring.mjs'});f.save();
