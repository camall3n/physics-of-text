+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import os from 'node:os';
+import crypto from 'node:crypto';
+import {loadPublication,PUBLICATION_RECORD,PREMERGE_LEDGER,MAINTENANCE_LEDGER,VERIFIER,MERGED_SOURCE_PATHS,OMITTED_METADATA_PATHS} from '../publication.mjs';
+const sha=s=>crypto.createHash('sha256').update(s).digest('hex');
+const fmt=x=>JSON.stringify(x,null,2)+'\n';
+function fixture(t) {
+ const repo=fs.mkdtempSync(path.join(os.tmpdir(),'publication-test-'));
+ t.after(()=>fs.rmSync(repo,{recursive:true,force:true}));
+ const write=(relative,value)=>{const file=path.join(repo,relative);fs.mkdirSync(path.dirname(file),{recursive:true});fs.writeFileSync(file,value);};
+ const baseline={files:{}},finalSourceManifest={files:{}},protectedEntries=[];
+ const ledger={schema_version:1,authorization:'Original authorization',changes:{}};
+ const beforeLedger=fmt(ledger);write(PREMERGE_LEDGER,beforeLedger);
+ const record={schema_version:1,authorization:'Explicit narrow publication approval',
+   pre_merge_maintenance_ledger:{path:PREMERGE_LEDGER,sha256:sha(beforeLedger)},
+   omitted_os_metadata:[],maintenance_transitions:[],source_transitions:[]};
+ for(const relative of OMITTED_METADATA_PATHS){
+  const raw='finder metadata '+relative;
+  const entry={path:relative,bytes:Buffer.byteLength(raw),sha256:sha(raw)};
+  baseline.files[relative]={kind:'file',category:'preserved',bytes:entry.bytes,sha256:entry.sha256};
+  record.omitted_os_metadata.push(entry);
+ }
+ for(const relative of MERGED_SOURCE_PATHS){
+  const old='before '+relative,now='after '+relative;
+  protectedEntries.push({path:relative,bytes:Buffer.byteLength(old),sha256:sha(old)});
+  write(relative,now);
+  const tr={path:relative,previous_sha256:sha(old),current_sha256:sha(now),reason:'Preserve upstream source merge'};
+  record.maintenance_transitions.push(tr);
+  ledger.changes[relative]={previous_sha256:[tr.previous_sha256],current_sha256:tr.current_sha256,reason:tr.reason};
+ }
+ write('experiments/nyt-beta-0p001-coverage-2026-09-14/protected_manifest.json',fmt({entries:protectedEntries}));
+ const old='old checker',now='new checker';write(VERIFIER,now);
+ finalSourceManifest.files[VERIFIER]={kind:'file',bytes:Buffer.byteLength(old),sha256:sha(old)};
+ record.source_transitions.push({path:VERIFIER,previous_sha256:sha(old),previous_bytes:Buffer.byteLength(old),current_sha256:sha(now),current_bytes:Buffer.byteLength(now),reason:'Permit exact publication transitions'});
+ const save=()=>{write(PUBLICATION_RECORD,fmt(record));write(MAINTENANCE_LEDGER,fmt(ledger));};save();
+ return {repo,write,record,ledger,baseline,finalSourceManifest,save,check:()=>loadPublication({repo,baseline,finalSourceManifest})};
+}
+test('no publication record preserves strict legacy mode',t=>{
+ const f=fixture(t);fs.unlinkSync(path.join(f.repo,PUBLICATION_RECORD));assert.equal(f.check(),null);
+});
+test('exact metadata omissions and source transitions are reported separately',t=>{
+ const f=fixture(t),result=f.check();assert.equal(result.omittedMetadata.size,3);assert.equal(result.sourceTransitions.size,1);
+ assert.equal(result.summary.data_or_deletion_exceptions_added,0);
+ assert.deepEqual(JSON.parse(result.preMergeLedgerRaw).changes,{});
+});
+test('present metadata must retain original bytes',t=>{
+ const f=fixture(t),relative=OMITTED_METADATA_PATHS[0];
+ f.write(relative,'finder metadata '+relative);assert.equal(f.check().omittedMetadata.size,2);
+ f.write(relative,'changed');assert.throws(f.check,/Present OS metadata/);
+});
+test('a metadata symlink cannot substitute for preserved bytes',t=>{
+ const f=fixture(t),relative=OMITTED_METADATA_PATHS[0];
+ fs.mkdirSync(path.dirname(path.join(f.repo,relative)),{recursive:true});
+ fs.symlinkSync('absent',path.join(f.repo,relative));assert.throws(f.check,/regular file/);
+});
+test('scientific files cannot be added to allowed omissions',t=>{
+ const f=fixture(t);f.record.omitted_os_metadata.push({path:'census/assessment.json',bytes:0,sha256:sha('')});f.save();
+ assert.throws(f.check,/OS metadata omissions scope changed/);
+});
+test('metadata baseline hashes cannot be replaced',t=>{
+ const f=fixture(t);f.record.omitted_os_metadata[0].sha256=sha('other');f.save();
+ assert.throws(f.check,/Metadata hash does not match baseline/);
+});
+test('ledger rejects extra data or deletion exceptions',t=>{
+ const f=fixture(t);f.ledger.changes['census/assessment.json']={previous_sha256:[sha('old')],current_sha256:null,reason:'Unrelated deletion'};f.save();
+ assert.throws(f.check,/beyond the two source transitions/);
