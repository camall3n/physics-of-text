+});
+test('changed pre-merge snapshot fails before any exception',t=>{
+ const f=fixture(t);f.write(PREMERGE_LEDGER,'{}');assert.throws(f.check,/Pre-merge ledger snapshot changed/);
+});
+test('source transition previous hashes must match frozen originals',t=>{
+ const f=fixture(t);f.record.maintenance_transitions[0].previous_sha256=sha('other');f.save();assert.throws(f.check,/previous hash mismatch/);
+});
+test('source transition must match actual merged bytes',t=>{
