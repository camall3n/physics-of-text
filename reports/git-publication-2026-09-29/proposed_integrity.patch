+// Narrow Git-publication compatibility; frozen scientific manifests remain authoritative.
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import assert from 'node:assert/strict';
+
+export const PUBLICATION_RECORD = 'reports/git-publication-2026-09-29/verification.json';
+export const PREMERGE_LEDGER = 'reports/git-publication-2026-09-29/pre_merge_maintenance_changes.json';
+export const MAINTENANCE_LEDGER = 'reports/buggy-evaluation-cleanup-2026-09-28/maintenance_changes.json';
+export const VERIFIER = 'code/evaluation/tests/migration/verify_baseline.mjs';
+export const MERGED_SOURCE_PATHS = Object.freeze([
+  'resources/sampler-140626/CHANGES.md',
+  'resources/sampler-140626/src/main/java/org/ucb/generative_ie/experiments/LexicalEntropyExperiment.java',
+]);
+export const OMITTED_METADATA_PATHS = Object.freeze([
+  'experiments/nyt-beta-0p001-coverage-2026-09-14/.DS_Store',
+  'experiments/nyt-beta-0p001-coverage-2026-09-14/census/.DS_Store',
+  'experiments/nyt-beta-0p001-coverage-2026-09-14/census/audit_06dbdb9b03af/.DS_Store',
+]);
+const sha = raw => crypto.createHash('sha256').update(raw).digest('hex');
+const hashPattern = /^[a-f0-9]{64}$/;
+function regular(repo, relative) {
+  const file = path.join(repo, relative);
+  assert(fs.lstatSync(file).isFile(), 'Publication input must be a regular file: ' + relative);
+  return fs.readFileSync(file);
+}
+function exactPaths(entries, expected, label) {
+  assert(Array.isArray(entries), label + ' must be an array');
+  assert.deepEqual(entries.map(e => e.path).sort(), [...expected].sort(), label + ' scope changed');
+}
+function keys(value, expected, label) {
+  assert.deepEqual(Object.keys(value).sort(), [...expected].sort(), label + ' fields changed');
+}
+function transition(t) {
+  assert(hashPattern.test(t.previous_sha256) && hashPattern.test(t.current_sha256), 'Invalid source transition hashes');
+  assert.notEqual(t.previous_sha256, t.current_sha256, 'Unchanged source cannot have a transition');
+  assert(typeof t.reason === 'string' && t.reason.trim(), 'Missing source transition reason');
+}
+
+// Optional: without the named publication record, original strict behavior is unchanged.
+export function loadPublication({repo, baseline, finalSourceManifest, ledgerPath = MAINTENANCE_LEDGER}) {
+  const recordPath = path.join(repo, PUBLICATION_RECORD);
+  if (!fs.existsSync(recordPath)) return null;
+  const record = JSON.parse(regular(repo, PUBLICATION_RECORD));
+  assert.equal(record.schema_version, 1, 'Unknown publication schema');
+  assert(typeof record.authorization === 'string' && record.authorization.trim(), 'Missing publication authorization');
+  const snapshot = record.pre_merge_maintenance_ledger;
+  keys(snapshot, ['path', 'sha256'], 'Pre-merge ledger snapshot');
+  assert.equal(snapshot.path, PREMERGE_LEDGER, 'Unexpected pre-merge ledger path');
+  assert(hashPattern.test(snapshot.sha256), 'Invalid pre-merge ledger hash');
+  const preMergeLedgerRaw = regular(repo, snapshot.path);
+  assert.equal(sha(preMergeLedgerRaw), snapshot.sha256, 'Pre-merge ledger snapshot changed');
+
+  exactPaths(record.omitted_os_metadata, OMITTED_METADATA_PATHS, 'OS metadata omissions');
+  const omittedMetadata = new Set();
+  for (const e of record.omitted_os_metadata) {
+    keys(e, ['path', 'bytes', 'sha256'], 'OS metadata omission');
+    const original = baseline.files[e.path];
+    assert(original && original.kind === 'file', 'Metadata absent from original baseline');
+    assert.equal(e.bytes, original.bytes, 'Metadata size does not match baseline');
+    assert.equal(e.sha256, original.sha256, 'Metadata hash does not match baseline');
+    let exists = true;
+    try { fs.lstatSync(path.join(repo, e.path)); } catch (error) {
+      if (error.code !== 'ENOENT') throw error;
+      exists = false;
+    }
+    if (!exists) { omittedMetadata.add(e.path); continue; }
+    const raw = regular(repo, e.path);
+    assert.equal(raw.length, e.bytes, 'Present OS metadata size changed: ' + e.path);
+    assert.equal(sha(raw), e.sha256, 'Present OS metadata hash changed: ' + e.path);
+  }
+
+  exactPaths(record.maintenance_transitions, MERGED_SOURCE_PATHS, 'Merged source transitions');
+  const protectedManifest = JSON.parse(regular(repo, 'experiments/nyt-beta-0p001-coverage-2026-09-14/protected_manifest.json'));
+  const protectedEntries = new Map(protectedManifest.entries.map(e => [e.path, e]));
+  const previousLedger = JSON.parse(preMergeLedgerRaw);
+  const actualLedger = JSON.parse(regular(repo, ledgerPath));
+  const expectedLedger = JSON.parse(preMergeLedgerRaw);
+  assert(typeof actualLedger.authorization === 'string' && actualLedger.authorization.startsWith(previousLedger.authorization), 'Publication removed historical ledger authorization');
+  expectedLedger.authorization = actualLedger.authorization;
+  for (const t of record.maintenance_transitions) {
+    keys(t, ['path', 'previous_sha256', 'current_sha256', 'reason'], 'Merged source transition');
+    transition(t);
+    const original = protectedEntries.get(t.path);
+    assert(original && original.sha256, 'Merged source absent from frozen manifest');
+    const old = previousLedger.changes[t.path];
+    assert.equal(t.previous_sha256, old?.current_sha256 ?? original.sha256, 'Merged source previous hash mismatch');
+    const raw = regular(repo, t.path);
+    assert.equal(sha(raw), t.current_sha256, 'Merged source current hash mismatch: ' + t.path);
+    if (old) assert(t.reason.includes(old.reason), 'Merged source reason removed historical explanation');
+    const prior = [...(old?.previous_sha256 ?? []), t.previous_sha256];
+    assert.equal(new Set(prior).size, prior.length, 'Duplicate merged source previous hashes');
+    expectedLedger.changes[t.path] = {...old, previous_sha256: prior, current_sha256: t.current_sha256, reason: t.reason};
+  }
+  assert.deepEqual(actualLedger, expectedLedger, 'Publication ledger contains changes beyond the two source transitions');
+
+  exactPaths(record.source_transitions, [VERIFIER], 'Publication checker transitions');
+  const sourceTransitions = new Map();
+  for (const t of record.source_transitions) {
+    keys(t, ['path', 'previous_sha256', 'previous_bytes', 'current_sha256', 'current_bytes', 'reason'], 'Publication checker transition');
+    transition(t);
+    const original = finalSourceManifest.files[t.path];
+    assert(original, 'Checker absent from frozen final-source manifest');
+    assert.equal(t.previous_sha256, original.sha256, 'Checker previous hash mismatch');
+    assert.equal(t.previous_bytes, original.bytes, 'Checker previous size mismatch');
+    const raw = regular(repo, t.path);
+    assert.equal(raw.length, t.current_bytes, 'Checker current size mismatch');
+    assert.equal(sha(raw), t.current_sha256, 'Checker current hash mismatch');
+    sourceTransitions.set(t.path, {bytes: t.current_bytes, sha256: t.current_sha256});
+  }
+  return {
+    preMergeLedgerRaw, omittedMetadata, sourceTransitions,
+    summary: {
+      record: PUBLICATION_RECORD,
+      allowed_os_metadata_paths: OMITTED_METADATA_PATHS.length,
+      omitted_os_metadata_count: omittedMetadata.size,
+      omitted_os_metadata: [...omittedMetadata],
+      exact_merged_source_transitions: record.maintenance_transitions,
+      exact_checker_transitions: record.source_transitions,
+      data_or_deletion_exceptions_added: 0,
+    },
+  };
+}
